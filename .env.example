# ─────────────────────────────────────────────────────────────────────────────
# 2nd Brain — environment template
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit real values. See SECURITY.md.
# Every variable is optional until the phase that needs it ships; the validator
# does not require any of them.
# ─────────────────────────────────────────────────────────────────────────────

# ── System ───────────────────────────────────────────────────────────────────
BRAIN_ENV=local                      # local | staging | production
BRAIN_TIMEZONE=Asia/Kolkata
BRAIN_LOCALE=en-IN
BRAIN_LOG_LEVEL=info                 # debug | info | warn | error

# ── AI providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# Default model per tier. Agents may override in their own definition.
BRAIN_MODEL_REASONING=claude-opus-5
BRAIN_MODEL_BALANCED=claude-sonnet-5
BRAIN_MODEL_FAST=claude-haiku-4-5-20251001

# ── Notion ───────────────────────────────────────────────────────────────────
NOTION_API_KEY=
NOTION_ROOT_PAGE_ID=                 # the 2nd Brain workspace root
NOTION_API_VERSION=2022-06-28

# ── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_TOKEN=                        # fine-grained, scoped to this repository
GITHUB_REPOSITORY=mittalok-creator/2nd-Brain

# ── Automation ───────────────────────────────────────────────────────────────
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_SECRET=

AXIOM_TOKEN=
AXIOM_ORG_ID=
AXIOM_DATASET=second-brain

# ── Google ───────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ── Microsoft ────────────────────────────────────────────────────────────────
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
ONEDRIVE_ROOT_FOLDER_ID=
